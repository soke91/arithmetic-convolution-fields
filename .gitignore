# The program's own record: process documents, exploratory code and the
# results that the paper does not cite. Kept on disk, deliberately not
# distributed -- it is a lab notebook, not a deliverable.
v1_log/
v1_verify_log/
v2_log/
v2_verify_log/
v3_log/

# Correspondence with third parties: sent mail, replies, drafts. On disk
# so that it sits with the work it is about, and never distributed --
# it is other people's words as much as ours, and it is not ours to
# publish. Nothing in the repository depends on it.
correspondence/

__pycache__/
*.pyc

# LaTeX build leavings. The compiled papers are distributed from
# deploy/pdf/; what pdflatex writes beside the source is not a
# deliverable and differs on every run.
deploy/papers/*.aux
deploy/papers/*.log
deploy/papers/*.out
deploy/papers/*.pdf
deploy/papers/*.toc

# 논제별 작업 공간. 초고·문헌 전사·레퍼리 예상 — 실험실 노트이고
# 배포물이 아니다. `LIT/` 는 남의 글을 그대로 옮겨 적은 것이라
# 더욱 올라가지 않는다.
thesis/
research/
